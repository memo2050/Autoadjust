ANTHROPIC_API_KEY=
REQUIRE_AUTH=false
FREE_DAILY_LIMIT=10
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BUILD_MODEL=claude-sonnet-5-5

# --- SOC module (see docs/SOC.md) ---
# Tokens: 32+ random characters each. Never commit real values. Roles: admin (everything), analyst (investigate/import, no approvals), viewer (read only), ingest (collector, can only send events).
SOC_ADMIN_TOKEN=
SOC_ANALYST_TOKEN=
SOC_VIEWER_TOKEN=
SOC_INGEST_TOKEN=
# Local testing only. Ignored when NODE_ENV=production. Gives everyone admin access.
SOC_DEV_AUTH=false
# Optional: model for the AI SOC Analyst (defaults to BUILD_MODEL)
SOC_MODEL=

# --- Wazuh (read-only). Leave empty to stay "not connected". See docs/SOC-WAZUH.md ---
# Direct mode: the Spark server reaches Wazuh itself.
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# WAZUH_INDEX=wazuh-alerts-*
# WAZUH_MIN_LEVEL=7
# WAZUH_ALLOW_HTTP=false
# WAZUH_SYNC_MINUTES=5
# Private CA for Wazuh: NODE_EXTRA_CA_CERTS=/path/to/root-ca.pem

# --- Multi-organization security (Phase 4, see docs/ARCHITECTURE-PHASE4.md). Names only here; never commit values. ---
# Needed for sign-in: the Supabase URL, the PUBLIC anon key (safe to expose) and the project's JWT secret (server only).
SUPABASE_JWT_SECRET=
# SOC_LEGACY_TOKENS=off disables the four shared SOC_*_TOKEN values entirely (they only ever reach the Default organization). Default: on, for compatibility.
SOC_LEGACY_TOKENS=
# Comma-separated Supabase user ids allowed to update shared reference data (CISA KEV). Empty = nobody except the legacy admin token.
PLATFORM_ADMIN_USER_IDS=

# --- Billing (Stripe). DEVELOPMENT = TEST MODE ONLY: use sk_test_ keys. A sk_live_ key is refused unless BILLING_MODE=live (a production decision). See docs/BILLING.md ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Plan limits (keys/executors/devices/retention) are applied only when this is exactly 1. Leave empty to keep current behaviour (no limits).
BILLING_ENFORCE=
APP_URL=
