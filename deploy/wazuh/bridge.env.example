# /etc/autoadjust/wazuh-bridge/<tenant>-<environment>.env   (chmod 600, owner root). NEVER commit a real one. You type the secrets yourself.
SPARK_URL=https://stellar-purple-horse-66.hostingersite.com
SPARK_INGEST_TOKEN=                # the tenant's aa_live_ key (scope soc, 90-day expiry, allowed IP = this server)
# Wazuh reached on localhost by node name (add "127.0.0.1 wazuh-manager wazuh-indexer" to /etc/hosts); TLS verification stays on.
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_INDEXER_URL=https://wazuh-indexer:9200
# generated by create-tenant.sh into /root/wazuh-tenant-<tenant>.secrets:
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_TENANT_GROUP=
WAZUH_TENANT_LABEL=
